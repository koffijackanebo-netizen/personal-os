# Crée un projet sur https://supabase.com puis copie ces valeurs
# depuis Project Settings > API. Copie ce fichier en .env et remplis-le.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Utilisé uniquement côté serveur par la fonction Edge "assistant"
# (à définir dans les secrets Supabase, PAS dans ce fichier .env) :
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
